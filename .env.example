# --- Next.js app (copy to .env.local) -----------------------------------
# Leave either of these empty and the app runs in labelled DEMO MODE:
# a recorded conversation and a static graph snapshot, no API calls.
OPENAI_API_KEY=
SIDECAR_URL=http://127.0.0.1:8000

# Optional
CHAT_MODEL=gpt-4o-mini
# Any OpenAI-compatible server (Ollama: http://localhost:11434/v1)
OPENAI_BASE_URL=
COGNEE_DATASET=nextjs_chat_memory
# Shared secret; must match SIDECAR_TOKEN on the sidecar if you set it there.
SIDECAR_TOKEN=
# Force demo mode even when keys are present (e.g. for a public deploy).
DEMO_MODE=

# --- Sidecar (docker compose reads these from .env) ---------------------
# Leave LLM_API_KEY empty to run cognee fully locally (GLiNER extraction +
# local fastembed embeddings, models download on first use).
LLM_API_KEY=
